news.lihor.ro {
	# Transitional Keycloak-only configuration. The Kubernetes Ingress owns
	# application routing and TLS after the staged appliance cutover. Do not run
	# this listener at the same time as an ingress controller that binds host
	# ports 80 and 443.
	#
	# Preserve the existing /keycloak route until an equivalent ingress route
	# has been tested; Keycloak migration is a separate operator boundary.
	handle /keycloak* {
		reverse_proxy 127.0.0.1:8081
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
}
